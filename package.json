{
  "name": "keluarga-frontend",
  "version": "1.0.0",
  "description": "Silsilah Keluarga - PWA pencatatan silsilah",
  "scripts": {
    "start": "vite --host --open",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --open",
    "serve": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "cf:dev": "npm run build && wrangler pages dev",
    "cf:preview": "npm run build && wrangler pages deploy dist --project-name silsilah-keluarga --branch preview",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name silsilah-keluarga --branch main",
    "cf:skema": "wrangler d1 execute silsilah --remote --file migrations/0001_skema.sql && wrangler d1 execute silsilah-preview --remote --file migrations/0001_skema.sql",
    "cf:skema-lokal": "wrangler d1 execute silsilah --local --file migrations/0001_skema.sql",
    "cf:impor": "wrangler d1 execute silsilah --remote --file tools/impor-prod.sql",
    "cf:impor-lokal": "wrangler d1 execute silsilah --local --file tools/impor-prod.sql",
    "cf:ekspor": "wrangler d1 export silsilah --remote --output=/home/nantaka/silsilah-backups/d1-silsilah-$(date +%Y%m%d).sql"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^2.5.3",
    "@tsconfig/svelte": "^5.0.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "type": "module"
}
