{
  "name": "keluarga-frontend",
  "version": "1.0.0",
  "description": "Silsilah Keluarga - PWA pencatatan silsilah",
  "scripts": {
    "start": "vite --host --open",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --open",
    "serve": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "cf:dev": "npm run build && npx -y wrangler@3.114.17 pages dev",
    "cf:deploy": "npm run build && npx -y wrangler@3.114.17 pages deploy dist --project-name silsilah-keluarga --branch main"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^2.5.3",
    "@tsconfig/svelte": "^5.0.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "type": "module"
}
